# Single source of pinned versions and training settings.
# Parsed as plain KEY=VALUE by both the bash and the PowerShell scripts (never sourced).
# No quotes, no spaces around '=', no shell expansion.

KIND_VERSION=v0.33.0
# The kind node image is pinned in kind-config.yaml.
KUBECTL_VERSION=v1.35.9
KUBELOGIN_VERSION=v0.2.20
FLUX_VERSION=2.8.8
PODINFO_IMAGE=ghcr.io/stefanprodan/podinfo:6.15.0
AZ_CLI_MIN_VERSION=2.60.0

# Training environment (trainer fills these in)
AKS_CONTEXT=dis-core-at22-aks
TRAINING_NAMESPACE=product-dis-padawan
